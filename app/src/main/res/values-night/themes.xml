<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WidgetDiccionario" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/papel</item>
        <item name="android:colorBackground">@color/papel</item>
        <item name="android:statusBarColor">@color/papel</item>
        <item name="android:navigationBarColor">@color/papel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorAccent">@color/tinta</item>
        <item name="android:colorControlActivated">@color/tinta</item>
        <item name="android:colorControlNormal">@color/tinta_suave</item>
        <item name="android:colorControlHighlight">#1FEFE7DC</item>
        <item name="android:textColorPrimary">@color/tinta</item>
        <item name="android:textColorSecondary">@color/tinta_suave</item>
        <item name="android:textColorLink">@color/tinta</item>
        <item name="android:fontFamily">@font/texto</item>
        <item name="android:alertDialogTheme">@style/Dialogo</item>
    </style>

    <style name="Dialogo" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialogo_fondo</item>
        <item name="android:colorAccent">@color/tinta</item>
        <item name="android:textColorPrimary">@color/tinta</item>
        <item name="android:textColorSecondary">@color/tinta_suave</item>
        <item name="android:fontFamily">@font/texto</item>
    </style>
</resources>
