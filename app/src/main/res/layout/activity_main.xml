<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/tinta" />

        </LinearLayout>

        <!-- Ficha de la palabra, al estilo de una entrada de diccionario -->
        <TextView
            style="@style/Texto.Numero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="@string/main_palabra_del_momento" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vista_palabra"
                style="@style/Texto.Palabra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Anemoia" />

            <TextView
                android:id="@+id/vista_categoria"
                style="@style/Texto.Categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="· f." />
        </LinearLayout>

        <View
            android:layout_width="170dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="12dp"
            android:background="@color/tinta" />

        <TextView
            android:id="@+id/vista_definicion"
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp"
            tools:text="La nostalgia por un tiempo que nunca viviste." />

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_pie"
            android:textColor="@color/tinta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/boton_nueva"
                style="@style/Boton.Linea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_boton_nueva" />

            <Button
                android:id="@+id/boton_coleccion"
                style="@style/Boton.Linea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/main_boton_coleccion" />
        </LinearLayout>

        <!-- Tres accesos: compartir, personalizar y funcionamiento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/acceso_compartir"
                style="@style/Acceso"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/main_acceso_compartir"
                android:src="@drawable/ic_compartir" />

            <ImageView
                android:id="@+id/acceso_personalizar"
                style="@style/Acceso"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:contentDescription="@string/main_acceso_personalizar"
                android:src="@drawable/ic_personalizar" />

            <ImageView
                android:id="@+id/acceso_funcionamiento"
                style="@style/Acceso"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:contentDescription="@string/main_acceso_funcionamiento"
                android:src="@drawable/ic_funcionamiento" />
        </LinearLayout>

        <!-- Pie -->
        <View
            style="@style/Linea"
            android:layout_marginTop="44dp" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:autoLink="web"
            android:text="@string/main_atribucion"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
