<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="36dp">

    <TextView
        android:id="@+id/paso_numero"
        style="@style/Texto.Numero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/paso_titulo"
        style="@style/Texto.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/paso_texto"
        style="@style/Texto.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <ImageView
        android:id="@+id/paso_imagen"
        tools:ignore="ContentDescription"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:background="@drawable/imagen_marco"
        android:padding="1dp"
        android:scaleType="fitCenter" />
</LinearLayout>
