<?xml version="1.0" encoding="utf-8"?>
<!-- keyguard habilita el widget en la pantalla de bloqueo (donde el sistema lo soporte). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_descripcion"
    android:initialLayout="@layout/widget_palabra"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_palabra"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
