<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/tinta" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/favoritas_titulo" />

            <TextView
                android:id="@+id/cantidad_favoritas"
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <View
                style="@style/Linea"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/favoritas_vacia"
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="12dp"
            android:text="@string/favoritas_vacia"
            android:textColor="@color/tinta_suave"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lista_favoritas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingBottom="96dp"
            android:scrollbarStyle="outsideOverlay" />
    </LinearLayout>

    <!-- Barra para deshacer la última favorita quitada. -->
    <LinearLayout
        android:id="@+id/barra_deshacer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/barra_deshacer_fondo"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/texto_deshacer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/texto"
            android:maxLines="1"
            android:paddingVertical="16dp"
            android:textColor="@color/papel"
            android:textSize="15sp" />

        <Button
            android:id="@+id/boton_deshacer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/texto"
            android:letterSpacing="0.12"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:stateListAnimator="@null"
            android:text="@string/favoritas_deshacer"
            android:textAllCaps="true"
            android:textColor="@color/papel"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
