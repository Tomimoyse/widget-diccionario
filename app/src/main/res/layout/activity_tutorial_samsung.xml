<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp">

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/tinta" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/marca_samsung" />

        <TextView
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tutorial_intro" />

        <View
            android:layout_width="170dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="20dp"
            android:background="@color/tinta" />

        <LinearLayout
            android:id="@+id/pasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/boton_galaxy_store"
            style="@style/Boton.Linea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/tutorial_boton_store" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tutorial_nota" />

        <!-- Samsung más viejos: FineLock -->
        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="4dp"
            android:text="@string/tutorial_finelock_etiqueta" />

        <View style="@style/Linea" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="24sp"
            android:text="@string/tutorial_finelock_titulo" />

        <TextView
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tutorial_finelock_texto" />

        <ImageView
            android:id="@+id/imagen_finelock"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/imagen_marco"
            android:contentDescription="@string/tutorial_finelock_imagen"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/tutorial_finelock" />

        <Button
            android:id="@+id/boton_finelock"
            style="@style/Boton.Linea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tutorial_finelock_boton" />
    </LinearLayout>
</ScrollView>
