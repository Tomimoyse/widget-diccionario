<?xml version="1.0" encoding="utf-8"?>
<!-- La caja se ajusta al texto y queda centrada en el espacio que asigna el launcher. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@android:id/background"
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_fondo"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Palabra y categoría ocupan el espacio libre; así una palabra larga no empuja la estrella. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/palabra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_palabra_ejemplo"
                    android:textColor="@color/widget_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="@string/widget_categoria_ejemplo"
                    android:textColor="@color/widget_texto_secundario"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <ImageView
                android:id="@+id/estrella"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="-6dp"
                android:contentDescription="@string/favorita_marcar"
                android:padding="4dp"
                android:src="@drawable/ic_estrella_vacia" />
        </LinearLayout>

        <TextView
            android:id="@+id/definicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/widget_definicion_ejemplo"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
